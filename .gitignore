# OS
.DS_Store

# Dependencies and generated application output
node_modules/
.venv/
venv/
out/
dist/
build/
# ...but the Electron app's build resources (icon.icns, logos) are source
!capcut-ai-studio/build/
release/
__pycache__/
*.pyc

# Local CodeGraph database (the nested .codegraph/.gitignore also protects it)
.codegraph/*
!.codegraph/.gitignore

# Historical agent skills duplicated by the current studio implementation
.claude/

# Generated media and experiment workspaces
work/
work_ref/
work_run/
work_video-test-new/
*.mp4
*.wav
*.jpg
*.png
# App images are source, not generated media
!capcut-ai-studio/build/**/*.png
!capcut-ai-studio/src/assets/**/*.png
# Skill motionmaxxing dong goi trong app: anh / am thanh cua skill la NGUON (Claude doc khi tao video)
!capcut-ai-studio/skills/**

# Legacy CapCut engine: separate upstream clone (sun-guannan/CapCutAPI) with its
# own .git; the app no longer imports it. Its .venv must stay on disk locally.
CapCutAPI/

# Build artifacts: embedded Python runtime + compiled sidecar (built by
# scripts/bundle-python.mjs + scripts/compile-sidecar.mjs during `npm run dist`)
capcut-ai-studio/resources/python/
capcut-ai-studio/resources/sidecar-dist/
capcut-ai-studio/resources/ffmpeg/
capcut-ai-studio/resources/models/

# Secrets
.env
.env.*

# R2 upload token (publish kho) - CHI o may tac gia, KHONG len git
r2-publish.json

# Icon cua ky nang GetTime (bat buoc di kem thu muc ky nang)
!gettime/agent-edit/icon.png

# Kho shot: thu muc xem thu (scripts/shot-still.mjs)
capcut-ai-studio/remotion-src/shotcraft/.preview/
capcut-ai-studio/remotion-src/shotcraft/.preview-public/

# Ban thu nghiem goc o root; ban dong goi duoc cap quyen nam trong capcut-ai-studio/skills/ (PROJECT_OVERVIEW 28).
/motion-video-director/
