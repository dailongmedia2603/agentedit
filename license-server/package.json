{
  "name": "agent-edit-license-server",
  "private": true,
  "type": "module",
  "scripts": {
    "keys": "node scripts/gen-keys.mjs",
    "dev:api": "wrangler dev --persist-to .wrangler/state --port 8787",
    "dev:admin": "wrangler dev -c wrangler.admin.toml --persist-to .wrangler/state --port 8788",
    "db:local": "wrangler d1 execute agent-edit-license --local --persist-to .wrangler/state --file schema.sql",
    "db:remote": "wrangler d1 execute agent-edit-license --remote --file schema.sql",
    "deploy:api": "wrangler deploy",
    "deploy:admin": "wrangler deploy -c wrangler.admin.toml",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
