#!/bin/bash
# AGENT EDIT CLI — loi vao cho ky nang GetTime (va moi AI agent / Terminal). Chay bang: bash agent-edit <lenh> [tham so]
#
# 1. Tim app "Agent Edit.app" tren may (AGENT_EDIT_APP, /Applications, ~/Applications — lay ban MOI nhat).
#    Chua co / cu hon MIN_VERSION -> `setup --key <KEY>` / `install --key <KEY>` tu tai ban moi nhat DUNG CHIP (Apple
#    Silicon / Intel) qua may chu ban quyen (key hop le moi tai duoc), kiem SHA-512 + CHU KY MA (chung chi rieng cua
#    Agent Edit), cai vao ~/Applications (hoac thay ban cu tai cho neu ghi duoc).
# 2. Chay app o CHE DO CLI (khong cua so, khong icon Dock): "<app>/Contents/MacOS/Agent Edit" --agent-edit-cli <lenh> ...
#    Moi lenh / tham so: bash agent-edit help
#
# Bien moi truong (tuy chon): AGENT_EDIT_APP (duong dan .app), AGENT_EDIT_CHANNEL (stable|test),
#   AGENT_EDIT_ARCH (arm64|x64 — ep kien truc khi tai). Chi de tu kiem: AGENT_EDIT_API (may chu), AGENT_EDIT_MIN_VERSION,
#   AGENT_EDIT_USER_DATA_DIR (thu muc du lieu Electron rieng — khong dung khoa API / key that cua may),
#   AGENT_EDIT_NO_SYSTEM_APP=1 (bo qua /Applications — tu kiem khong dung toi app that cua may), AGENT_EDIT_DL_BUDGET (giay).
# --background (1.7.0, AI agent): moi lan goi chi tai toi da AGENT_EDIT_DL_BUDGET giay (mac dinh 150) -> chua xong thi in JSON
#   {"status":"running","step":"download","progress":...} + ma thoat 3; goi lai dung lenh do tai tiep (curl -C -). Tai xong ->
#   cai app -> `setup --background` cua app (tra ma viec cai cong cu + dong bo kho).
# CHE DO CONG CU GETTIME (`tool <viec>`, 2026-10-20 — tool.json canh SKILL.md): GetTime goi thang (khong shell, khong can
#   Toan quyen), moi lenh tra 1 khoi JSON trong <= 25 giay, key ban quyen qua bien AGENT_EDIT_KEY (GetTime cat trong Keychain).
#   Viec dai tra MA VIEC ngay, GetTime tu hoi `tool job <ma>` vai giay 1 lan: r_/s_/l_ = viec cua app (doc thang job.json, khong
#   mo app moi lan hoi) · i_ = tai + cai app (script chay nen) · u_ = cap nhat app. Du lieu tai ve: $GETTIME_TOOL_DATA.
# Chi dung bash 3.2 + cong cu co san cua macOS (curl, plutil, shasum, ditto, codesign) — khong can Node / Python / jq.
set -u

MIN_VERSION="${AGENT_EDIT_MIN_VERSION:-1.5.0}"
# che do cong cu can `setup --background` + `login --start` (1.7.0); `setup --key-env` (key qua bien moi truong) tu 1.20.0
TOOL_MIN_VERSION="${AGENT_EDIT_TOOL_MIN_VERSION:-1.7.0}"
KEY_ENV_VERSION="1.20.0"
API="${AGENT_EDIT_API:-https://agent-edit-license.agent-edit-license-server.workers.dev}"
# Chu ky ma cua MOI ban Agent Edit phat hanh (chung chi tu tao "Agent Edit Code Signing", scripts/gen-mac-cert.mjs)
SIGN_REQ='identifier "app.autocapcut.desktop" and certificate root = H"9a7d7c51b4f600386062947f759b2247d42709d2"'
# GetTime: moi thu tai ve nam o thu muc du lieu rieng cua cong cu (ngoai thu muc ky nang — dong bo co the thay ca thu muc do)
if [ -n "${GETTIME_TOOL_DATA:-}" ]; then WORK="$GETTIME_TOOL_DATA/download"; else WORK="$HOME/.capcut-studio/cli/download"; fi
DL_BUDGET="${AGENT_EDIT_DL_BUDGET:-150}"
BACKGROUND=""
for a in "$@"; do [ "$a" = "--background" ] && BACKGROUND=1; done
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# viec nen cua che do cong cu (tai + cai app = i_, cap nhat = u_) — dang chay trong viec nao (die ghi loi vao do)
BOOT_DIR=""

say() { printf '%s\n' "$*" >&2; } # thong bao ra stderr -> stdout cua lenh `--json` van la JSON sach
die() {
  say "Lỗi: $*"
  [ -n "$BOOT_DIR" ] && boot_state error "" "" "$*"
  exit 2
}

# chuoi JSON (bash 3.2, khong jq)
jstr() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/}
  s=${s//$'\t'/ }
  printf '"%s"' "$s"
}

# boot_state <status> <step> <progress 0..1> <message> [app_job] — ghi trang thai viec nen i_ / u_ (ghi nguyen tu)
boot_state() {
  [ -n "$BOOT_DIR" ] || return 0
  local st="$1" step="$2" prog="$3" msg="$4" appjob="${5:-}" body
  body="{\"id\":$(jstr "$(basename "$BOOT_DIR")"),\"status\":$(jstr "$st")"
  [ -n "$step" ] && body="$body,\"step\":$(jstr "$step")"
  [ -n "$prog" ] && body="$body,\"progress\":$prog"
  if [ "$st" = error ]; then
    body="$body,\"message\":$(jstr "$msg"),\"error\":{\"message\":$(jstr "$msg")}"
  else
    body="$body,\"message\":$(jstr "$msg")"
  fi
  [ -n "$appjob" ] && body="$body,\"app_job\":$(jstr "$appjob")"
  printf '%s}\n' "$body" >"$BOOT_DIR/state.json.tmp" && mv -f "$BOOT_DIR/state.json.tmp" "$BOOT_DIR/state.json"
}

[ "$(uname -s)" = "Darwin" ] || die "Agent Edit CLI chỉ chạy trên macOS."

# $1 >= $2 (x.y.z)
ver_ge() {
  local a b i x y
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  for i in 0 1 2; do
    x="${a[$i]:-0}"; y="${b[$i]:-0}"
    x="${x%%[!0-9]*}"; y="${y%%[!0-9]*}"
    [ "${x:-0}" -gt "${y:-0}" ] && return 0
    [ "${x:-0}" -lt "${y:-0}" ] && return 1
  done
  return 0
}

app_version() { /usr/bin/plutil -extract CFBundleShortVersionString raw "$1/Contents/Info.plist" 2>/dev/null || echo 0; }

# App Agent Edit MOI nhat tren may (khong lay ban tu kiem "Agent Edit Update Selftest.app")
find_app() {
  local best="" bestv="0" p v
  for p in "${AGENT_EDIT_APP:-}" "/Applications/Agent Edit.app" "$HOME/Applications/Agent Edit.app"; do
    [ -n "$p" ] && [ -x "$p/Contents/MacOS/Agent Edit" ] || continue
    [ -n "${AGENT_EDIT_NO_SYSTEM_APP:-}" ] && [ "$p" = "/Applications/Agent Edit.app" ] && continue
    [ -n "${AGENT_EDIT_APP:-}" ] && [ "$p" = "$AGENT_EDIT_APP" ] && { printf '%s\n' "$p"; return 0; }
    v=$(app_version "$p")
    if [ -z "$best" ] || ! ver_ge "$bestv" "$v"; then best="$p"; bestv="$v"; fi
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}

cpu_arch() {
  if [ -n "${AGENT_EDIT_ARCH:-}" ]; then echo "$AGENT_EDIT_ARCH"; return; fi
  # hw.optional.arm64 = 1 tren Apple Silicon ke ca khi shell nay chay qua Rosetta -> van tai ban arm64 (nhanh hon)
  [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ] && echo arm64 || echo x64
}

jget() { /usr/bin/plutil -extract "$2" raw -o - "$1" 2>/dev/null; }

# install_app <KEY> [duong dan .app can thay] -> in duong dan app da cai (stdout)
install_app() {
  local key="$1" replace="${2:-}" arch osv meta code url file size sha ver build zip got stage new target old n
  arch=$(cpu_arch)
  osv=$(/usr/bin/sw_vers -productVersion)
  ver_ge "$osv" "14.0" || die "Agent Edit cần macOS 14 trở lên (máy đang chạy macOS $osv)."
  mkdir -p "$WORK"
  meta="$WORK/offer.json"
  say "Lấy bản Agent Edit mới nhất cho máy $([ "$arch" = arm64 ] && echo 'Apple Silicon' || echo 'Intel')..."
  # key di trong than yeu cau (stdin), khong nam tren dong lenh (ps khong thay)
  code=$(printf '{"key":"%s","platform":"darwin","arch":"%s","channel":"%s"}' "$key" "$arch" "${AGENT_EDIT_CHANNEL:-stable}" |
    /usr/bin/curl -sS --max-time 60 -o "$meta" -w '%{http_code}' -X POST -H 'content-type: application/json' \
      --data-binary @- "$API/v1/download") || die "Không kết nối được máy chủ Agent Edit — kiểm tra mạng rồi chạy lại."
  if [ "$(jget "$meta" ok)" != "true" ]; then
    die "$(jget "$meta" message || echo "Máy chủ trả mã HTTP $code.")"
  fi
  url=$(jget "$meta" url); file=$(jget "$meta" file); size=$(jget "$meta" size); sha=$(jget "$meta" sha512)
  ver=$(jget "$meta" version); build=$(jget "$meta" build)
  if [ -n "$replace" ] && ver_ge "$(app_version "$replace")" "$ver"; then
    say "Agent Edit trên máy ($(app_version "$replace")) đã là bản mới nhất ($ver) — không cần tải."
    rm -f "$meta"
    printf '%s\n' "$replace"
    return 0
  fi
  case "$file" in *.zip) ;; *) die "Máy chủ trả gói không hợp lệ ($file).";; esac
  case "$file" in */* | *..*) die "Tên gói không hợp lệ ($file).";; esac
  zip="$WORK/$file"
  say "Tải Agent Edit $ver (build $build) — $((size / 1048576)) MB (mạng rớt thì chạy lại, tải tiếp chỗ dở)..."
  n=0
  while ! { [ -f "$zip" ] && [ "$(stat -f %z "$zip")" = "$size" ]; }; do
    n=$((n + 1))
    [ "$n" -gt 6 ] && die "Tải chưa trọn sau 6 lần — kiểm tra mạng rồi chạy lại (tải tiếp chỗ dở)."
    if [ -f "$zip" ] && [ "$(stat -f %z "$zip")" -gt "$size" ]; then rm -f "$zip"; fi
    if [ -n "$BACKGROUND" ]; then
      # AI agent: tai toi da DL_BUDGET giay roi bao tien do (lenh khong bi cat o gioi han 10 phut, nguoi truc thay %)
      /usr/bin/curl -fL -sS -C - --retry 2 --retry-delay 3 --max-time "$DL_BUDGET" -o "$zip" "$url" 2>/dev/null
      got=0
      [ -f "$zip" ] && got=$(stat -f %z "$zip")
      if [ "$got" != "$size" ]; then
        pct=$((got * 100 / size))
        printf '{"ok":true,"status":"running","step":"download","progress":0.%02d,"message":"Đang tải Agent Edit %s — %d%% (%d/%d MB)","next":"Chạy lại đúng lệnh này để tải tiếp"}\n' \
          "$pct" "$ver" "$pct" "$((got / 1048576))" "$((size / 1048576))" >"$WORK/progress.json"
        exit 3
      fi
      break
    fi
    if [ -n "$BOOT_DIR" ]; then
      # viec nen cua GetTime: tai mot mach, cu 2 giay ghi % vao state.json (GetTime hien tren the tien do)
      /usr/bin/curl -fL -sS -C - --retry 3 --retry-delay 3 -o "$zip" "$url" 2>/dev/null &
      cpid=$!
      while kill -0 "$cpid" 2>/dev/null; do
        got=0
        [ -f "$zip" ] && got=$(stat -f %z "$zip")
        pct=$((got * 100 / size))
        [ "$pct" -gt 99 ] && pct=99
        boot_state running download "0.$(printf '%02d' "$pct")" \
          "Đang tải Agent Edit $ver — $pct% ($((got / 1048576))/$((size / 1048576)) MB)"
        sleep 2
      done
      wait "$cpid" || sleep 3
      continue
    fi
    /usr/bin/curl -fL -sS -C - --retry 3 --retry-delay 3 -o "$zip" "$url" || sleep 3
  done
  boot_state running install 0.99 "Đã tải xong, đang kiểm tra chữ ký và cài Agent Edit ${ver}…"
  got=$(/usr/bin/shasum -a 512 -b "$zip" | cut -d' ' -f1 | /usr/bin/xxd -r -p | /usr/bin/base64)
  if [ "$got" != "$sha" ]; then
    rm -f "$zip"
    die "File tải về sai mã SHA-512 — đã xoá, chạy lại để tải lại."
  fi
  stage="$WORK/stage-$ver-$build"
  rm -rf "$stage"
  mkdir -p "$stage"
  /usr/bin/ditto -x -k "$zip" "$stage" || die "Giải nén gói cài lỗi."
  new="$stage/Agent Edit.app"
  [ -d "$new" ] || die "Gói cài thiếu Agent Edit.app."
  /usr/bin/codesign --verify --deep --strict -R="$SIGN_REQ" "$new" 2>/dev/null ||
    die "Chữ ký mã của app tải về KHÔNG khớp bản chính chủ Agent Edit — đã dừng, không cài."
  target="$HOME/Applications/Agent Edit.app"
  if [ -n "$replace" ] && [ -w "$(dirname "$replace")" ] && [ -w "$replace" ]; then target="$replace"; fi
  # app dang mo (giao dien / viec CLI dang chay tu goi do) -> khong thay giua chung
  if [ -e "$target" ] && /usr/bin/pgrep -f "$target/Contents/MacOS/Agent Edit" >/dev/null 2>&1; then
    die "Agent Edit đang chạy ($target) — đóng app / đợi việc đang chạy xong rồi chạy lại."
  fi
  mkdir -p "$(dirname "$target")"
  if [ -e "$target" ]; then
    old="$target.cu-$(date +%Y%m%d%H%M%S)"
    mv "$target" "$old" || die "Không thay được $target (app đang mở? thiếu quyền?)."
    if ! mv "$new" "$target"; then
      mv "$old" "$target"
      die "Không cài được vào $target."
    fi
    rm -rf "$old"
  else
    mv "$new" "$target" || die "Không cài được vào $target."
  fi
  /usr/bin/xattr -dr com.apple.quarantine "$target" 2>/dev/null || true
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$target" >/dev/null 2>&1 || true
  rm -rf "$stage" "$zip" "$meta"
  say "Đã cài Agent Edit $ver tại: $target"
  printf '%s\n' "$target"
}

# ---- tham so --key (setup / install) ----
cmd="${1:-help}"
KEY=""
prev=""
for a in "$@"; do
  [ "$prev" = "--key" ] && KEY="$a"
  case "$a" in --key=*) KEY="${a#--key=}";; esac
  prev="$a"
done
KEY=$(printf '%s' "$KEY" | tr -cd 'A-Za-z0-9-')

APP=$(find_app)
APPV=$([ -n "$APP" ] && app_version "$APP" || echo 0)

# =====================================================================================================================
# CHE DO CONG CU GETTIME: `agent-edit tool <viec> [tham so]` (tool.json). Moi lenh in DUNG 1 khoi JSON ra stdout.
# Ma thoat: 0 = tra loi duoc (ke ca "dang chay") · 1 = loi that (GetTime danh dau loi cho AI).
# =====================================================================================================================
TJ="${GETTIME_TOOL_DATA:-$HOME/.capcut-studio/cli}/tool-jobs"
APP_JOBS="$HOME/.capcut-studio/cli/jobs"
KEEP_KEY=""
RUN_OUT=""
RUN_RC=0

tool_out() {
  printf '%s\n' "$1"
  exit 0
}
# tool_fail <loi> [goi y]
tool_fail() {
  local hint=""
  [ -n "${2:-}" ] && hint=",\"hint\":$(jstr "$2")"
  printf '{"ok":false,"error":{"message":%s%s}}\n' "$(jstr "$1")" "$hint"
  exit 1
}

# lenh chay app o che do CLI -> mang APP_CMD (key ban quyen CHI di theo khi kich hoat)
app_cmd() {
  APP_CMD=(/usr/bin/env -u ELECTRON_RUN_AS_NODE)
  [ -n "$KEEP_KEY" ] || APP_CMD+=(-u AGENT_EDIT_KEY)
  APP_CMD+=("$APP/Contents/MacOS/Agent Edit")
  [ -n "${AGENT_EDIT_USER_DATA_DIR:-}" ] && APP_CMD+=("--user-data-dir=$AGENT_EDIT_USER_DATA_DIR")
  APP_CMD+=(--agent-edit-cli)
}

# app_run <giay> <tham so...>: chay CLI cua app toi da <giay> (GetTime cat moi lenh o 25 giay) -> RUN_OUT, RUN_RC (124 = het gio).
# Viec nen ma app tach ra (make / setup / login) la tien trinh rieng, khong bi dung theo.
app_run() {
  local limit=$(($1 * 5)) n=0 tmp pid
  shift
  app_cmd
  mkdir -p "$TJ"
  tmp="$TJ/.out.$$"
  (exec "${APP_CMD[@]}" "$@") >"$tmp" 2>/dev/null </dev/null &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$n" -ge "$limit" ]; then
      kill "$pid" 2>/dev/null
      sleep 1
      kill -9 "$pid" 2>/dev/null
      RUN_OUT=$(cat "$tmp" 2>/dev/null)
      rm -f "$tmp"
      RUN_RC=124
      return 0
    fi
    sleep 0.2
    n=$((n + 1))
  done
  wait "$pid"
  RUN_RC=$?
  RUN_OUT=$(cat "$tmp" 2>/dev/null)
  rm -f "$tmp"
  return 0
}

# in ket qua app_run. soft = moi cau tra loi JSON deu la "tra loi duoc" (vd login-check: chua dang nhap khong phai loi)
tool_relay() {
  [ -n "$RUN_OUT" ] || tool_fail "Agent Edit không trả lời (mã $RUN_RC)." "Gọi lại; vẫn lỗi thì mở app Agent Edit xem có thông báo gì không."
  printf '%s\n' "$RUN_OUT"
  [ "${1:-}" = soft ] && exit 0
  case "$RUN_RC" in 0 | 3) exit 0 ;; esac
  case "$RUN_OUT" in *'"ok": true'* | *'"ok":true'*) exit 0 ;; esac
  exit 1
}

# JSON cua RUN_OUT -> file tam de plutil doc tung truong
run_json_file() {
  mkdir -p "$TJ"
  printf '%s' "$RUN_OUT" >"$TJ/.json.$$"
  printf '%s\n' "$TJ/.json.$$"
}

tool_need_app() {
  [ -n "$APP" ] || tool_fail "Máy chưa cài Agent Edit." "Gọi hành động setup (cần key bản quyền)."
  ver_ge "$APPV" "$TOOL_MIN_VERSION" ||
    tool_fail "Agent Edit trên máy là bản $APPV — quá cũ." "Gọi hành động setup để cập nhật (hoặc mở app Agent Edit cho nó tự cập nhật)."
}

# ma viec: r_/s_/l_ (app) · i_/u_ (script) · mv-YYYYMMDD-HHMMSS-xxxx (Tao video) · post_... (dang Phone Agent)
valid_id() { [[ "$1" =~ ^([irslu]_[a-z0-9]{6,24}|mv-[0-9]{8}-[0-9]{6}-[a-z0-9]{2,8}|post_[a-z0-9]{6,30})$ ]]; }

# dich vu nen cua app (Tao video / Automation / dang bai) dang song? (file svc-*.json do app ghi, pid con chay)
svc_alive() {
  local f pid
  for f in "$HOME/.capcut-studio/cli/svc"/svc-*.json; do
    [ -f "$f" ] || continue
    pid=$(jget "$f" pid)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

# viec Tao video / bai dang: dich vu ghi file trang thai moi khi doi buoc -> doc thang (khong mo app moi 3 giay); dich vu da
# tat giua chung -> hoi app (app bat lai dich vu, danh dau video bi gian doan)
tool_svc_job() {
  local id="$1" f st
  case "$id" in
    mv-*) f="$HOME/.capcut-studio/cli/motion/$id.json" ;;
    *) f="$HOME/.capcut-studio/cli/posts/$id.json" ;;
  esac
  if [ -f "$f" ]; then
    st=$(jget "$f" status)
    case "$st" in done | error | cancelled) tool_out "$(cat "$f")" ;; esac
    svc_alive && tool_out "$(cat "$f")"
  fi
  tool_need_app
  case "$id" in
    mv-*) app_run 20 motion status "$id" --json ;;
    *) app_run 20 post status "$id" --json ;;
  esac
  [ "$RUN_RC" = 124 ] && tool_out '{"ok":true,"status":"running","message":"Đang chạy."}'
  tool_relay soft
}

# viec nen i_ (tai + cai app) con dang chay -> in ma viec
boot_running() {
  local d pid
  for d in "$TJ"/i_*; do
    [ -f "$d/state.json" ] && [ -f "$d/pid" ] || continue
    [ "$(jget "$d/state.json" status)" = running ] || continue
    pid=$(cat "$d/pid" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { basename "$d"; return 0; }
  done
  return 1
}

# ---- tool status: dieu `check` cua GetTime doc (ready) — ban gon (khong dua 50 muc Doctor vao chat) ----
tool_status() {
  local boot=""
  boot=$(boot_running) || boot=""
  if [ -z "$APP" ] || ! ver_ge "$APPV" "$TOOL_MIN_VERSION"; then
    local inst=false msg="Máy chưa cài Agent Edit."
    if [ -n "$APP" ]; then inst=true; msg="Agent Edit trên máy là bản $APPV — quá cũ, cần cập nhật."; fi
    [ -n "$boot" ] && msg="Đang tải và cài Agent Edit (việc $boot)."
    tool_out "{\"ok\":true,\"ready\":false,\"installed\":$inst,\"version\":$(jstr "$APPV"),\"message\":$(jstr "$msg"),\"next\":[\"setup\"]$([ -n "$boot" ] && printf ',"installing":%s' "$(jstr "$boot")")}"
  fi
  app_run 22 status --json
  [ "$RUN_RC" = 124 ] && tool_out '{"ok":true,"ready":false,"installed":true,"message":"Agent Edit chưa trả lời kịp (máy đang bận?) — kiểm tra lại sau ít giây."}'
  local f ready lic licmsg n i st next="" fails="" item
  f=$(run_json_file)
  ready=$(jget "$f" ready)
  if [ -z "$ready" ]; then
    rm -f "$f"
    tool_relay
  fi
  lic=$(jget "$f" license.status)
  licmsg=$(jget "$f" license.message)
  n=$(jget "$f" checks)
  i=0
  while [ "$i" -lt "${n:-0}" ]; do
    st=$(jget "$f" "checks.$i.status")
    if [ "$st" = fail ]; then
      item="$(jget "$f" "checks.$i.label") — $(jget "$f" "checks.$i.detail")"
      fails="$fails${fails:+,}$(jstr "$item")"
    fi
    i=$((i + 1))
  done
  # goi y cua app (lenh dong lenh) -> ten hanh dong cua ky nang
  n=$(jget "$f" next)
  i=0
  while [ "$i" -lt "${n:-0}" ]; do
    case "$(jget "$f" "next.$i")" in
      *activate*) item="setup (kích hoạt key bản quyền)" ;;
      *"login gemini"*) item="login gemini" ;;
      *"login claude"*) item="login claude" ;;
      *"login codex"*) item="login codex (tuỳ chọn: ảnh AI)" ;;
      *gemini-key*) item="API key Gemini: nhập trong app Agent Edit › Cài đặt API (hoặc đổi sang đăng nhập)" ;;
      *claude-key*) item="API key Claude: nhập trong app Agent Edit › Cài đặt API (hoặc đổi sang đăng nhập)" ;;
      *setup*) item="setup" ;;
      *) item="$(jget "$f" "next.$i")" ;;
    esac
    next="$next${next:+,}$(jstr "$item")"
    i=$((i + 1))
  done
  tool_out "{\"ok\":true,\"ready\":$ready,\"installed\":true,\"version\":$(jstr "$(jget "$f" version)"),\"license\":{\"status\":$(jstr "$lic"),\"message\":$(jstr "$licmsg")},\"missing\":[$fails],\"next\":[$next]$([ -n "$boot" ] && printf ',"installing":%s' "$(jstr "$boot")")}"
  rm -f "$f"
}

# `setup --background` cua app (kich hoat key truoc neu ban quyen chua OK) -> RUN_OUT / RUN_RC
app_setup_bg() {
  local args=(setup --background --json)
  if [ -n "$KEY" ]; then
    app_run 8 license --json
    case "$RUN_OUT" in
      *'"status": "ok"'* | *'"status":"ok"'*) ;;
      *)
        if ver_ge "$APPV" "$KEY_ENV_VERSION"; then
          KEEP_KEY=1
          args+=(--key-env)
        else
          args+=(--key "$KEY")
        fi
        ;;
    esac
  fi
  app_run 15 "${args[@]}"
  KEEP_KEY=""
}

# ---- tool setup: cai app (neu chua co / qua cu) + kich hoat key + cai cong cu + dong bo kho — viec dai ----
tool_setup() {
  local cur id dir
  cur=$(boot_running) && tool_out "{\"ok\":true,\"id\":$(jstr "$cur"),\"status\":\"running\",\"message\":\"Đang có lượt tải và cài Agent Edit chạy.\"}"
  if [ -z "$APP" ] || ! ver_ge "$APPV" "$TOOL_MIN_VERSION"; then
    [ -n "$KEY" ] || tool_fail "Cần key bản quyền Agent Edit để tải và cài app." "Gọi gettime_ask_field cho trường license-key, người trực lưu xong thì gọi lại setup."
    id="i_$(date +%s)$((RANDOM % 900 + 100))"
    dir="$TJ/$id"
    mkdir -p "$dir"
    BOOT_DIR="$dir"
    boot_state running download 0 "Đang lấy bản Agent Edit mới nhất…"
    BOOT_DIR=""
    # tach han khoi lenh nay: khong giu stdout / stderr (GetTime cho dong ong ra), khong doc stdin
    nohup /bin/bash "$SELF" __tool-boot "$id" </dev/null >"$dir/log.txt" 2>&1 &
    printf '%s\n' "$!" >"$dir/pid"
    tool_out "{\"ok\":true,\"id\":$(jstr "$id"),\"status\":\"running\",\"message\":\"Bắt đầu tải và cài Agent Edit (thường 5–20 phút).\"}"
  fi
  app_setup_bg
  [ "$RUN_RC" = 124 ] && tool_fail "Agent Edit chưa trả lời kịp." "Gọi lại setup sau ít giây."
  tool_relay
}

# viec nen i_: tai + kiem chu ky + cai app -> `setup --background` cua app (ma s_ ghi vao state.json -> `tool job i_` doc tiep)
# viec nen i_ thoat ma trang thai van "running" (chua giao cho app) -> ghi loi kem buoc + duoi nhat ky (khong de "dung bat thuong" tron)
boot_exit() {
  local rc="$1" f="$BOOT_DIR/state.json" step tailmsg
  [ -n "$BOOT_DIR" ] && [ -f "$f" ] || return 0
  [ -f "$BOOT_DIR/cancelled" ] && return 0 # tool cancel tu ghi "Đã dừng"
  [ "$(jget "$f" status)" = running ] || return 0
  printf '[%s] viec nen thoat ma %s%s\n' "$(date +%H:%M:%S)" "$rc" "${BOOT_SIG:+ (tin hieu $BOOT_SIG)}" >>"$BOOT_DIR/log.txt"
  [ -n "${BOOT_SIG:-}" ] && rc="$rc, tín hiệu $BOOT_SIG"
  [ -n "$(jget "$f" app_job)" ] && return 0
  step=$(jget "$f" step)
  tailmsg=$(tail -n 3 "$BOOT_DIR/log.txt" 2>/dev/null | tr '\n' ' ' | cut -c1-300)
  boot_state error "" "" "Việc cài Agent Edit dừng giữa chừng (mã $rc, bước ${step:-?})${tailmsg:+: $tailmsg} — gọi lại setup."
}

tool_boot_run() {
  BOOT_DIR="$TJ/$1"
  [ -d "$BOOT_DIR" ] || exit 2
  trap 'boot_exit $?' EXIT
  local sg
  for sg in TERM INT PIPE QUIT; do trap "BOOT_SIG=$sg; exit 1" "$sg"; done
  local new sid
  new=$(install_app "$KEY" "$APP") || exit 2
  APP="$new"
  APPV=$(app_version "$APP")
  boot_state running license 0.99 "Đã cài Agent Edit $APPV, đang kích hoạt key và bắt đầu cài công cụ…"
  app_setup_bg
  sid=""
  if [ -n "$RUN_OUT" ]; then
    local f
    f=$(run_json_file)
    sid=$(jget "$f" id)
    if [ -z "$sid" ]; then
      boot_state error "" "" "$(jget "$f" error || jget "$f" error.message || echo "Kích hoạt / cài công cụ không thành công.")"
      rm -f "$f"
      exit 1
    fi
    rm -f "$f"
  fi
  [ -n "$sid" ] || die "Agent Edit đã cài nhưng chưa khởi động được bước cài công cụ — gọi lại setup."
  boot_state running tools 0 "Đã cài app, đang cài công cụ (5–20 phút)…" "$sid"
}

# viec nen u_: cap nhat app (lenh `update` cua app chay mot mach, co the lau)
tool_update_run() {
  BOOT_DIR="$TJ/$1"
  [ -d "$BOOT_DIR" ] || exit 2
  local f="$BOOT_DIR/out.json" to
  app_cmd
  "${APP_CMD[@]}" update --json >"$f" 2>>"$BOOT_DIR/log.txt" </dev/null
  if [ "$(jget "$f" ok)" = true ]; then
    if [ "$(jget "$f" updated)" = true ]; then
      to=$(jget "$f" to)
      boot_state done "" 1 "Đã tải bản ${to:-mới} — Agent Edit tự thay app trong khoảng 30 giây."
    else
      boot_state done "" 1 "Agent Edit đang ở bản mới nhất ($(jget "$f" version || echo "$APPV"))."
    fi
  else
    boot_state error "" "" "$(jget "$f" error || echo "Cập nhật không thành công.")"
  fi
}

# trang thai 1 viec cua app: doc thang job.json (khong mo app moi 3 giay); tien trinh viec da chet -> hoi app (app danh dau loi)
tool_app_job() {
  local id="$1" f="$APP_JOBS/$1/job.json" st pid
  if [ -f "$f" ]; then
    st=$(jget "$f" status)
    pid=$(jget "$f" pid)
    case "$st" in done | error | cancelled) tool_out "$(cat "$f")" ;; esac
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && tool_out "$(cat "$f")"
    [ "$st" = queued ] && [ -z "$pid" ] && tool_out "$(cat "$f")"
  fi
  tool_need_app
  app_run 15 job "$id" --json
  [ "$RUN_RC" = 124 ] && tool_out '{"ok":true,"status":"running","message":"Đang chạy."}'
  tool_relay soft
}

tool_job() {
  local id="${1:-}" dir pid st appjob
  valid_id "$id" || tool_fail "Mã việc không hợp lệ: $id"
  case "$id" in
    i_* | u_*)
      dir="$TJ/$id"
      [ -f "$dir/state.json" ] || tool_fail "Không có việc $id."
      appjob=$(jget "$dir/state.json" app_job)
      [ -n "$appjob" ] && valid_id "$appjob" && tool_app_job "$appjob"
      st=$(jget "$dir/state.json" status)
      pid=$(cat "$dir/pid" 2>/dev/null)
      if [ "$st" = running ] && ! { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }; then
        BOOT_DIR="$dir"
        boot_state error "" "" "Tiến trình $([ "${id:0:1}" = i ] && echo 'tải và cài' || echo 'cập nhật') đã dừng bất thường — gọi lại $([ "${id:0:1}" = i ] && echo setup || echo update). Nhật ký: $dir/log.txt"
        BOOT_DIR=""
      fi
      tool_out "$(cat "$dir/state.json")"
      ;;
    mv-* | post_*) tool_svc_job "$id" ;;
    *) tool_app_job "$id" ;;
  esac
}

tool_cancel() {
  local id="${1:-}" dir pid appjob
  valid_id "$id" || tool_fail "Mã việc không hợp lệ: $id"
  case "$id" in
    i_* | u_*)
      dir="$TJ/$id"
      [ -f "$dir/state.json" ] || tool_fail "Không có việc $id."
      appjob=$(jget "$dir/state.json" app_job)
      if [ -n "$appjob" ] && valid_id "$appjob"; then
        tool_need_app
        app_run 18 cancel "$appjob" --json
      fi
      pid=$(cat "$dir/pid" 2>/dev/null)
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        : >"$dir/cancelled"
        /usr/bin/pkill -P "$pid" 2>/dev/null
        kill "$pid" 2>/dev/null
      fi
      BOOT_DIR="$dir"
      boot_state cancelled "" "" "Đã dừng."
      BOOT_DIR=""
      tool_out '{"ok":true,"status":"cancelled"}'
      ;;
  esac
  tool_need_app
  case "$id" in
    mv-*) app_run 18 motion cancel "$id" --json ;;
    post_*) app_run 18 post cancel "$id" --json ;;
    *) app_run 18 cancel "$id" --json ;;
  esac
  [ "$RUN_RC" = 124 ] && tool_out '{"ok":true,"status":"cancelling","message":"Đã gửi lệnh dừng."}'
  tool_relay
}

# tool cli <lenh cua app...>: chay 1 lenh CLI cua app (Tao video, Automation, dang bai, Video da tao, cai dat...) va tra JSON.
# O nhieu dong cua GetTime -> lap lai tham so: --vars / --post-vars / --sources (moi dong 1 --var / --post-var / --source).
CLI_SVC_MIN_VERSION="${AGENT_EDIT_FEATURE_MIN_VERSION:-1.21.0}"
# Bot Telegram (lenh `telegram`, token qua `tool keys`) co tu app 1.22.0
TELEGRAM_MIN_VERSION="${AGENT_EDIT_FEATURE_MIN_VERSION:-1.22.0}"
tool_cli() {
  local args=() prev="" line flag
  tool_need_app
  ver_ge "$APPV" "$CLI_SVC_MIN_VERSION" ||
    tool_fail "Agent Edit trên máy (bản $APPV) chưa có chức năng này qua chat." "Gọi hành động update để cập nhật Agent Edit rồi thử lại."
  if [ "${1:-}" = telegram ] && ! ver_ge "$APPV" "$TELEGRAM_MIN_VERSION"; then
    tool_fail "Agent Edit trên máy (bản $APPV) chưa có Bot Telegram." "Gọi hành động update để cập nhật Agent Edit rồi thử lại."
  fi
  for a in "$@"; do
    if [ -n "$prev" ]; then
      case "$prev" in --vars) flag=--var ;; --post-vars) flag=--post-var ;; *) flag=--source ;; esac
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        [ -n "$line" ] && args+=("$flag" "$line")
      done <<<"$a"
      prev=""
      continue
    fi
    case "$a" in --vars | --post-vars | --sources) prev="$a"; continue ;; esac
    args+=("$a")
  done
  app_run 22 "${args[@]}" --json
  [ "$RUN_RC" = 124 ] && tool_fail "Agent Edit chưa trả lời kịp (lần đầu bật chạy nền có thể lâu hơn)." "Gọi lại sau vài giây."
  tool_relay
}

# tool keys: dua key SaydiVoice / token Phone Agent nguoi truc nhap trong GetTime (Keychain cua GetTime, toi day qua bien moi
# truong) vao app Agent Edit (luu ma hoa nhu nhap o Cai dat API). Chi gui muc da nhap — khong xoa key dang co cua app.
tool_keys() {
  local out="" bad=""
  tool_need_app
  ver_ge "$APPV" "$CLI_SVC_MIN_VERSION" || tool_fail "Agent Edit trên máy (bản $APPV) chưa nhận key qua chat." "Gọi hành động update rồi thử lại."
  KEEP_KEY=1
  if [ -n "${AGENT_EDIT_SAYDI_KEY:-}" ]; then
    app_run 20 settings saydi-key --json
    out="$out${out:+,}\"saydi\":$(printf '%s' "${RUN_OUT:-null}" | tr -d '\n')"
    [ "$RUN_RC" = 0 ] || bad=1
  fi
  if [ -n "${AGENT_EDIT_PA_TOKEN:-}" ]; then
    app_run 20 settings phoneagent-token --json
    out="$out${out:+,}\"phoneAgent\":$(printf '%s' "${RUN_OUT:-null}" | tr -d '\n')"
    [ "$RUN_RC" = 0 ] || bad=1
  fi
  if [ -n "${AGENT_EDIT_TG_TOKEN:-}" ]; then
    if ver_ge "$APPV" "$TELEGRAM_MIN_VERSION"; then
      app_run 20 telegram token --json
      out="$out${out:+,}\"telegram\":$(printf '%s' "${RUN_OUT:-null}" | tr -d '\n')"
      [ "$RUN_RC" = 0 ] || bad=1
    else
      out="$out${out:+,}\"telegram\":{\"ok\":false,\"error\":\"Agent Edit bản $APPV chưa có Bot Telegram — gọi update rồi gọi lại keys.\"}"
      bad=1
    fi
  fi
  KEEP_KEY=""
  [ -n "$out" ] || tool_fail "Chưa có key nào được nhập trong GetTime." "Gọi gettime_ask_field cho trường saydi-key, phoneagent-token hoặc telegram-bot-token trước."
  if [ -n "$bad" ]; then
    printf '{"ok":false,%s}\n' "$out"
    exit 1
  fi
  tool_out "{\"ok\":true,$out}"
}

tool_update() {
  local id dir
  tool_need_app
  id="u_$(date +%s)$((RANDOM % 900 + 100))"
  dir="$TJ/$id"
  mkdir -p "$dir"
  BOOT_DIR="$dir"
  boot_state running update "" "Đang kiểm tra và tải bản Agent Edit mới…"
  BOOT_DIR=""
  nohup /bin/bash "$SELF" __tool-update "$id" </dev/null >"$dir/log.txt" 2>&1 &
  printf '%s\n' "$!" >"$dir/pid"
  tool_out "{\"ok\":true,\"id\":$(jstr "$id"),\"status\":\"running\",\"message\":\"Đang cập nhật Agent Edit.\"}"
}

# tool login <tai khoan> [--device] / login-code <tai khoan> <ma> / login-check <tai khoan>
tool_login() {
  local sub="$1" acc="${2:-}"
  case "$acc" in gemini | claude | codex) ;; *) tool_fail "Tài khoản phải là gemini, claude hoặc codex." ;; esac
  tool_need_app
  case "$sub" in
    login)
      if [ "${3:-}" = "--device" ]; then app_run 20 login "$acc" --start --device --json; else app_run 20 login "$acc" --start --json; fi
      [ "$RUN_RC" = 124 ] && tool_out "{\"ok\":true,\"status\":\"running\",\"account\":\"$acc\",\"message\":\"Đang mở trang đăng nhập — gọi login-check sau vài giây để lấy link.\"}"
      tool_relay soft
      ;;
    login-code)
      [ -n "${3:-}" ] || tool_fail "Thiếu mã đăng nhập."
      app_run 20 login "$acc" --code "$3" --json
      [ "$RUN_RC" = 124 ] && tool_out "{\"ok\":true,\"status\":\"running\",\"account\":\"$acc\",\"message\":\"Đã gửi mã, đang chờ xác nhận — gọi login-check sau vài giây.\"}"
      tool_relay
      ;;
    login-check)
      app_run 20 login "$acc" --check --json
      [ "$RUN_RC" = 124 ] && tool_out "{\"ok\":true,\"status\":\"running\",\"account\":\"$acc\",\"message\":\"Chưa có kết quả — gọi lại login-check sau vài giây.\"}"
      tool_relay soft
      ;;
  esac
}

# tool make <tham so cua make>. Tu lieu chen: --insert-notes / --insert-uses / --insert-placements "<dong 1>\n<dong 2>" — DONG i
# la cua tu lieu thu i (dong trong = mac dinh: khong ghi chu / show / auto) -> --insert-note / -use / -placement cung thu tu.
# --brand-font-file (file font gui trong chat) can app >= FONT_FILE_VERSION.
FONT_FILE_VERSION="${AGENT_EDIT_FEATURE_MIN_VERSION:-1.21.0}"
tool_make() {
  local args=() prev="" line lines flag dflt has_font=""
  tool_need_app
  for a in "$@"; do
    if [ -n "$prev" ]; then
      case "$prev" in
        --insert-notes) flag=--insert-note dflt="" ;;
        --insert-uses) flag=--insert-use dflt=show ;;
        *) flag=--insert-placement dflt=auto ;;
      esac
      # bo dong trong o CUOI (giu dong trong o giua: van la cua 1 tu lieu)
      lines=()
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        lines+=("$line")
      done <<<"$a"
      while [ "${#lines[@]}" -gt 0 ] && [ -z "${lines[${#lines[@]}-1]}" ]; do unset "lines[${#lines[@]}-1]"; done
      for line in ${lines[@]+"${lines[@]}"}; do
        [ -n "$line" ] || line="$dflt"
        args+=("$flag" "$line")
      done
      prev=""
      continue
    fi
    case "$a" in
      --insert-notes | --insert-uses | --insert-placements) prev="$a"; continue ;;
      --brand-font-file | --from | --no-inserts | --no-reference) has_font=1 ;;
    esac
    args+=("$a")
  done
  if [ -n "$has_font" ] && ! ver_ge "$APPV" "$FONT_FILE_VERSION"; then
    tool_fail "Agent Edit trên máy (bản $APPV) chưa hỗ trợ file font gửi qua chat / làm lại video đã tạo (from)." "Gọi hành động update (cập nhật Agent Edit) rồi gọi lại make."
  fi
  app_run 22 make "${args[@]}" --json
  [ "$RUN_RC" = 124 ] && tool_fail "Agent Edit chưa nhận việc kịp." "Gọi hành động jobs xem việc đã được tạo chưa trước khi gọi lại make."
  tool_relay
}

# tool jobs — danh sach gon 8 viec gan nhat
tool_jobs() {
  local f n i rows="" id st msg file err
  tool_need_app
  app_run 20 jobs --json
  [ "$RUN_RC" = 124 ] && tool_fail "Agent Edit chưa trả lời kịp." "Gọi lại sau ít giây."
  f=$(run_json_file)
  n=$(jget "$f" jobs)
  [ "${n:-0}" -gt 8 ] && n=8
  i=0
  while [ "$i" -lt "${n:-0}" ]; do
    id=$(jget "$f" "jobs.$i.id")
    st=$(jget "$f" "jobs.$i.status")
    msg=$(jget "$f" "jobs.$i.message")
    file=$(jget "$f" "jobs.$i.result.copy" || jget "$f" "jobs.$i.result.output")
    err=$(jget "$f" "jobs.$i.error.message")
    rows="$rows${rows:+,}{\"id\":$(jstr "$id"),\"kind\":$(jstr "$(jget "$f" "jobs.$i.kind")"),\"status\":$(jstr "$st"),\"createdAt\":$(jstr "$(jget "$f" "jobs.$i.createdAt")"),\"message\":$(jstr "$msg")"
    [ -n "$file" ] && rows="$rows,\"file\":$(jstr "$file")"
    [ -n "$err" ] && rows="$rows,\"error\":$(jstr "$err")"
    rows="$rows}"
    i=$((i + 1))
  done
  rm -f "$f"
  tool_out "{\"ok\":true,\"jobs\":[$rows]}"
}

if [ "$cmd" = "tool" ] || [ "$cmd" = "__tool-boot" ] || [ "$cmd" = "__tool-update" ]; then
  # key ban quyen: CHI tu bien moi truong (GetTime cat trong Keychain) — khong bao gio tren dong lenh
  KEY=$(printf '%s' "${AGENT_EDIT_KEY:-}" | tr -cd 'A-Za-z0-9-')
  case "$cmd" in
    __tool-boot) tool_boot_run "${2:-}"; exit 0 ;;
    __tool-update) tool_update_run "${2:-}"; exit 0 ;;
  esac
  sub="${2:-}"
  shift 2 2>/dev/null || shift $#
  case "$sub" in
    status) tool_status ;;
    setup) tool_setup ;;
    job) tool_job "${1:-}" ;;
    cancel) tool_cancel "${1:-}" ;;
    login | login-code | login-check) tool_login "$sub" "$@" ;;
    make) tool_make "$@" ;;
    jobs) tool_jobs ;;
    update) tool_update ;;
    cli) tool_cli "$@" ;;
    keys) tool_keys ;;
    *) tool_fail "Không có việc \"$sub\" (status | setup | job | cancel | login | login-code | login-check | make | jobs | update | cli | keys)." ;;
  esac
  exit 0
fi

# install_app chay trong subshell: ma 3 = tai chua xong (--background) -> in JSON tien do, thoat 3
dl_partial() {
  [ "$1" = 3 ] || exit 2
  cat "$WORK/progress.json" 2>/dev/null
  rm -f "$WORK/progress.json"
  exit 3
}

if [ "$cmd" = "install" ]; then
  # Cai / cap nhat app len ban moi nhat (ke ca khi da co) — can key
  [ -n "$KEY" ] || die "Cần key bản quyền: bash agent-edit install --key <KEY>"
  (install_app "$KEY" "$APP") >/dev/null || dl_partial $?
  exit 0
fi

if [ -z "$APP" ] || ! ver_ge "$APPV" "$MIN_VERSION"; then
  if [ -n "$KEY" ]; then
    APP=$(install_app "$KEY" "$APP") || dl_partial $?
  elif [ -z "$APP" ]; then
    die "Máy chưa cài Agent Edit. Chạy: bash agent-edit setup --key <KEY>  (tự tải + cài app đúng chip, rồi cài công cụ)."
  else
    die "Agent Edit trên máy là bản $APPV, cần bản $MIN_VERSION trở lên để chạy dòng lệnh. Mở app Agent Edit để nó tự cập nhật, hoặc chạy: bash agent-edit setup --key <KEY>"
  fi
fi

# VSCode / mot so terminal dat ELECTRON_RUN_AS_NODE -> binary app chay nhu node roi thoat ngay
if [ -n "${AGENT_EDIT_USER_DATA_DIR:-}" ]; then
  exec /usr/bin/env -u ELECTRON_RUN_AS_NODE "$APP/Contents/MacOS/Agent Edit" "--user-data-dir=$AGENT_EDIT_USER_DATA_DIR" --agent-edit-cli "$@"
fi
exec /usr/bin/env -u ELECTRON_RUN_AS_NODE "$APP/Contents/MacOS/Agent Edit" --agent-edit-cli "$@"
